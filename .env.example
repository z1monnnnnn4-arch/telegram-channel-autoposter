BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# Окно случайного времени поста (каждый день новое), часы по TIMEZONE
POST_WINDOW_START=08:00
POST_WINDOW_END=22:00

# Часовой пояс для расписания и отображения (Europe/Moscow = МСК)
TIMEZONE=Europe/Moscow
TIMEZONE_LABEL=МСК

# Пауза между каналами при совпадении времени
CHANNEL_DELAY_SEC=4

DB_PATH=data/bot.db
