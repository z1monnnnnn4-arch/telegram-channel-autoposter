# Получить на https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Номер телефона аккаунта, на котором каналы (формат: +79991234567)
PHONE=+79991234567

# Токен бота для управления (@BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram user id админов (через запятую). Узнать: @userinfobot
ADMIN_IDS=123456789

# Время ежедневной рассылки (локальное время сервера), формат HH:MM
POST_TIME=10:00

# Пауза между постами в разные каналы (секунды). Для 1000 каналов: 3-5 сек ≈ 1 час
POST_DELAY_SEC=4

# Максимум каналов за один прогон (0 = все)
MAX_CHANNELS_PER_RUN=0

# Папка с текстами постов (.txt) и картинками (.jpg/.png)
CONTENT_DIR=content

# Сколько фото прикреплять к посту (0 = только текст, макс 10)
PHOTOS_PER_POST=1

# SQLite база
DATABASE_PATH=data/bot.db
