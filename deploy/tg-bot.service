[Unit]
Description=Telegram channel autoposter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgbot
Group=tgbot
WorkingDirectory=/opt/tg_bot
EnvironmentFile=/opt/tg_bot/.env
ExecStart=/opt/tg_bot/.venv/bin/python main.py
Restart=always
RestartSec=5

# Один процесс — дубли блокируются bot.lock в data/
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
